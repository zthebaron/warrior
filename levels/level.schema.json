{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dbai.agency/schemas/level.v2.json",
  "title": "Level (v2 - move-annotated critical path)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "chapter",
    "palette",
    "spawn",
    "goal",
    "bounds",
    "geometry",
    "checkpoints",
    "critical_path",
    "difficulty"
  ],
  "definitions": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "maxLength": 48
    },
    "assetRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "maxLength": 48
    },
    "collider": {
      "enum": [
        "trimesh",
        "capsule",
        "sphere",
        "none"
      ],
      "description": "No 'box': with the verified KCC (snapToGround 0.5) a standing capsule sinks through cuboid colliders, fixed or kinematic. Proven by npm run check:physics (FLOOR SINK). Use trimesh."
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "pos"
      ],
      "properties": {
        "asset": {
          "$ref": "#/definitions/assetRef"
        },
        "pos": {
          "$ref": "#/definitions/vec3"
        },
        "rot": {
          "$ref": "#/definitions/vec3"
        },
        "scale": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 50
            },
            {
              "$ref": "#/definitions/vec3"
            }
          ]
        },
        "collider": {
          "$ref": "#/definitions/collider"
        },
        "tag": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "move": {
      "enum": [
        "ground",
        "jump",
        "double",
        "dash",
        "dashjump",
        "wall",
        "climb",
        "platform"
      ]
    },
    "waypoint": {
      "oneOf": [
        {
          "$ref": "#/definitions/vec3"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pos",
            "via"
          ],
          "properties": {
            "pos": {
              "$ref": "#/definitions/vec3"
            },
            "via": {
              "$ref": "#/definitions/move"
            },
            "platform": {
              "$ref": "#/definitions/id"
            },
            "note": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      ]
    }
  },
  "properties": {
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "chapter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "palette": {
      "type": "string",
      "maxLength": 32
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pos",
        "facing"
      ],
      "properties": {
        "pos": {
          "$ref": "#/definitions/vec3"
        },
        "facing": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pos"
      ],
      "properties": {
        "type": {
          "enum": [
            "reach"
          ],
          "description": "Win is arriving (Q4). No other goal type exists."
        },
        "pos": {
          "$ref": "#/definitions/vec3"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/definitions/vec3"
        },
        "max": {
          "$ref": "#/definitions/vec3"
        }
      }
    },
    "fog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "near": {
          "type": "number",
          "minimum": 0
        },
        "far": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1200,
      "items": {
        "$ref": "#/definitions/placement"
      }
    },
    "platforms": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "path",
          "duration"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "asset": {
            "$ref": "#/definitions/assetRef"
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "$ref": "#/definitions/vec3"
            }
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "easing": {
            "enum": [
              "linear",
              "sine",
              "ease-in-out",
              "step"
            ]
          },
          "loop": {
            "enum": [
              "pingpong",
              "cycle",
              "once"
            ]
          },
          "collider": {
            "$ref": "#/definitions/collider"
          },
          "startDelay": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "fall",
              "spike",
              "crush",
              "water",
              "patroller"
            ]
          },
          "y": {
            "type": "number"
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "size": {
            "$ref": "#/definitions/vec3"
          },
          "period": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "$ref": "#/definitions/vec3"
            },
            "description": "patroller: the fixed route it walks. Fixed, so its whole sweep is known statically (Q1, Q6)."
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 40,
            "description": "patroller: units/s along path."
          },
          "phase": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1,
            "description": "patroller: start offset as a fraction of one loop. Position is a pure function of the world clock: phase + t*speed (Q6)."
          }
        },
        "description": "A hazard is a moving fall plane (Q6): touching one is death, nothing else. The patroller lives here, not in an enemies array, so nothing invites AI (Q7). speed and phase are mandatory on a patroller (Q2). Water survives only as a flat wash (Q2c): a still plane at \"y\", never animated (no period/path/speed/phase), never reflective.",
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "patroller"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "path",
                "speed",
                "phase"
              ],
              "properties": {
                "path": true,
                "speed": true,
                "phase": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "water"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "y"
              ],
              "properties": {
                "y": true,
                "period": false,
                "path": false,
                "speed": false,
                "phase": false
              }
            }
          }
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pos"
        ],
        "properties": {
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "facing": {
            "type": "number"
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "maxLength": 32
        },
        "ambienceZone": {
          "type": "string",
          "maxLength": 32
        }
      },
      "description": "No light direction or strength in level data (STYLE \u00a71). The greybox light is an engine constant until the ink shader replaces it."
    },
    "cameras": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "pos",
          "lookAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 32
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "lookAt": {
            "$ref": "#/definitions/vec3"
          }
        }
      }
    },
    "critical_path": {
      "type": "array",
      "minItems": 2,
      "maxItems": 60,
      "items": {
        "$ref": "#/definitions/waypoint"
      },
      "description": "Ordered route the nav bot must traverse. Index 0 is spawn (bare vec3 allowed). Every later entry MUST declare via."
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "description": "There is no score, par_time or rank field (Q4), and no enemies, interactables or collectibles (Q7), and additionalProperties:false rejects one if added to a level. That absence IS the no-score rule (PHASE-0-DECISIONS Q4 amendment 2): a field an agent sees is a field it wires up. Do not add one here."
}
