{
  "name": "warrior",
  "version": "1.0.0",
  "description": "Warrior \u2014 AI-built 3D browser action-platformer. Proofline game track PGT-01.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tools/harness",
    "assets:build": "node tools/assets/build.mjs",
    "assets:budget": "node tools/assets/budget.mjs",
    "lint:accent": "node tools/assets/accent.mjs",
    "lint:levels": "for f in levels/[0-9]*.json; do node tools/lint-level.mjs \"$f\" assets/dist/manifest.json || exit 1; done",
    "lint:self": "node tools/lint-self.mjs",
    "lint:example": "node tools/lint-level.mjs tools/example-level.json tools/manifest.example.json",
    "lint:not-list": "node tools/lint-not-list.mjs",
    "check:physics": "node tools/rapier-determinism.mjs",
    "check:patrol": "node tools/check-patrol.ts",
    "check:progression": "node tools/check-progression.ts",
    "check:webgl": "node tools/webgl-preflight.mjs",
    "playtest": "node tools/harness/run.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "ajv": "^8.20.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.187.0",
    "draco3dgltf": "1.5.9",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "type": "module"
}
